# pnpm security best practices
# Only allow packages that have been published for at least 2 days
age-threshold=2

# Auto-install peer dependencies to avoid missing peers
auto-install-peers=true

# Exclude links from lockfile for cleaner diffs
exclude-links-from-lockfile=true

# Use strict peer dependencies — fail if peers are unsatisfied
strict-peer-dependencies=false

# Prefer latest compatible version when resolving
prefer-latest=false

# Enable shamefully-hoist for legacy compatibility (disable for better isolation)
shamefully-hoist=false
