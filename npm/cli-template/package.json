{
  "name": "@dallay/cli-template",
  "version": "0.0.0",
  "description": "A Rust CLI template project",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cli-template": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
