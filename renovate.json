{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Europe/Madrid",
  "schedule": [
    "* * * * 1-5"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "2 days",
  "separateMinorPatch": true,
  "packageRules": [
    {
      "description": "Automerge stable patch updates for Rust and npm",
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Group Rust minor dependencies",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Rust dependencies (minor)"
    },
    {
      "description": "Group npm minor dependencies",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "npm dependencies (minor)"
    },
    {
      "description": "Group Docker minor updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Docker dependencies (minor)"
    },
    {
      "description": "Group GitHub Actions minor updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "GitHub Actions (minor)"
    },
    {
      "description": "Use chore for all dependency updates",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    }
  ]
}
